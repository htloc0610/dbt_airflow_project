),

customer_sales as (
    select
        c.customer_id,
        c.full_name,
        c.territory_id,
        count(distinct s.sales_order_id) as total_orders,
        sum(s.line_total) as total_revenue,
        avg(s.line_total) as avg_order_value,
        sum(s.order_qty) as total_items_purchased,
