        p.SellStartDate,
        p.SellEndDate,
        p.DiscontinuedDate,
        ps.Name as SubcategoryName,
        ps.ProductCategoryID,
        p.ModifiedDate as last_modified_date
    from product p
    left join product_subcategory ps
        on p.ProductSubcategoryID = ps.ProductSubcategoryID
)

select * from staged;
