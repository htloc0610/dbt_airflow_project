[0m01:30:39.676387 [debug] [Thread-3  ]: On model.dbt_sqlserver_project.gld_product_performance: /* {"app": "dbt", "dbt_version": "1.8.7", "profile_name": "dbt_airflow_project", "target_name": "dev", "node_id": "model.dbt_sqlserver_project.gld_product_performance"} */


    USE [AdventureWorks2014];
