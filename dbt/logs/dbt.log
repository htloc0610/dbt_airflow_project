    h.due_date,
    h.ship_date,
    h.status,
    h.online_order_flag,
    h.sales_order_number,
    h.purchase_order_number,
    h.customer_id,
    h.sales_person_id,
    h.territory_id,
    d.order_detail_id,
    d.product_id,
    d.order_qty,
    d.unit_price,
    d.unit_price_discount,
    d.line_total
from sales_order_header h
left join sales_order_detail d
    on h.sales_order_id = d.sales_order_id;
    ')


