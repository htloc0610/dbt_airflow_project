        SellStartDate as sell_start_date,
        SellEndDate as sell_end_date,
        case 
            when DiscontinuedDate is not null then 1
            else 0
        end as is_discontinued,
        last_modified_date
    from bronze_products
)

select * from cleaned;
    ')

