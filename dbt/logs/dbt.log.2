    select * from "AdventureWorks2014"."Sales"."Customer"
),

person as (
    select * from "AdventureWorks2014"."Person"."Person"
),

staged as (
    select
        c.CustomerID,
        p.FirstName,
        p.LastName,
        p.EmailPromotion,
        c.StoreID,
        c.TerritoryID,
