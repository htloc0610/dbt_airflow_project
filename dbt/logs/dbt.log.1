        concat(coalesce(FirstName, ''Unknown''), '' '', coalesce(LastName, ''Unknown'')) as full_name,
        EmailPromotion as email_promotion,
        StoreID as store_id,
        TerritoryID as territory_id,
        last_modified_date
    from bronze_customers
)

select * from cleaned;
    ')

