        p.product_id,
        p.product_name,
        p.subcategory_name,
        p.color,
        p.list_price,
        p.standard_cost,
        count(distinct s.sales_order_id) as total_orders,
        sum(s.order_qty) as total_quantity_sold,
        sum(s.line_total) as total_revenue,
        avg(s.unit_price) as avg_selling_price,
