        ProductName as product_name,
        ProductNumber as product_number,
        coalesce(Color, ''N/A'') as color,
        StandardCost as standard_cost,
        ListPrice as list_price,
        coalesce(Size, ''N/A'') as size,
        coalesce(Weight, 0) as weight,
