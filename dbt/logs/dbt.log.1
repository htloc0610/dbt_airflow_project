        end as profit_margin_pct
    from products p
    left join sales s
        on p.product_id = s.product_id
    group by 
        p.product_id, 
        p.product_name, 
        p.subcategory_name, 
        p.color, 
        p.list_price, 
        p.standard_cost
)

