        sales_person_id,
        territory_id,
        product_id,
        order_qty,
        unit_price,
        unit_price_discount,
        line_total,
        -- Calculated fields
        unit_price * order_qty as gross_amount,
        line_total / nullif(order_qty, 0) as effective_unit_price,
        case 
            when unit_price_discount > 0 then 1
            else 0
        end as has_discount
    from bronze_sales
    where order_qty > 0
        and unit_price >= 0
)

select * from cleaned;
    ')

